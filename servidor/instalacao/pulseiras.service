[Unit]
Description=Servidor Flask das Pulseiras (Gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=filipe
Group=filipe
WorkingDirectory=/home/filipe/Desktop/Tese/servidor/painel
Environment="PATH=/home/filipe/Desktop/Tese/servidor/venv/bin"
ExecStart=/home/filipe/Desktop/Tese/servidor/venv/bin/gunicorn -w 4 -b 127.0.0.1:5000 server:app

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
